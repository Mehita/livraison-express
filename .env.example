# Copy this file to .env and fill in the values.
#
# No default value is provided on purpose: choosing what a setting defaults to is
# part of the work. Every key below is read by
# src/livraison_express/config.py (see session 1).

# --- General ---
# environment: local | test | prod. Read it to switch behaviour without touching the code.
ENVIRONMENT=

# --- Model ---
# Path to the .joblib file produced by the notebook (cell 41).
MODEL_PATH=

# Decision threshold above which an order is considered eligible (cell 31).
MODEL_THRESHOLD=

# --- Data store ---
# Connection string or path of the store you implement for your OrderStore adapter.
# Examples: postgresql://user:password@localhost:5432/livraison_express
#           redis://localhost:6379/0
#           sqlite:///./local.db
ORDER_STORE_DSN=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
MODEL_VERSION=
