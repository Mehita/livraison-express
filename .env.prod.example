# Copier en .env.prod (ignoré par Git) et renseigner de vraies valeurs.
# Mot de passe en caractères URL-safe (lettres, chiffres) : il est inséré dans l'URI MongoDB.
#   printf 'MONGO_USER=livraison\nMONGO_PASSWORD=%s\n' "$(openssl rand -hex 16)" > .env.prod
MONGO_USER=livraison
MONGO_PASSWORD=changez-moi
